# ============================================================
# Mentora — Environment Configuration Template
# ============================================================
# DO NOT commit the real .env file. This file is a template only.
# Copy to .env and fill in your values for LOCAL DEVELOPMENT ONLY.
#
# For CI/CD and production builds, use --dart-define flags:
#   flutter build apk \
#     --dart-define=BACKEND_BASE_URL=http://pihub.local:8000 \
#     --dart-define=BACKEND_API_KEY=your_key_here
# ============================================================

# Backend gateway URL (Pi Hub or local dev server)
BACKEND_BASE_URL=http://pihub.local:8000

# API key for backend authentication (leave empty for open local dev)
BACKEND_API_KEY=

# Backend request timeout in seconds
BACKEND_TIMEOUT_SECONDS=10

# Deployment mode: development | production
DEPLOYMENT_MODE=development

# Feature flags
ENABLE_BACKEND=true
ENABLE_OFFLINE_PACKS=true
ENABLE_LOCAL_INFERENCE=true
AUTO_SYNC_ON_RECONNECT=true
