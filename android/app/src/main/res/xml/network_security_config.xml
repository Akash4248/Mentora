<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for Mentora
  - Cleartext HTTP is ONLY allowed for local Pi gateway (pihub.local), mDNS, local subnets, and emulator loopback (10.0.2.2).
  - All other traffic (internet) requires TLS.
  - Replaces blanket android:usesCleartextTraffic="true" in AndroidManifest.xml.
-->
<network-security-config>
    <!-- Allow cleartext for local Pi gateway, mDNS devices, loopback, and Android emulator host -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Pi gateway hostnames -->
        <domain includeSubdomains="true">pihub.local</domain>
        <!-- mDNS .local devices (peer-to-peer) -->
        <domain includeSubdomains="true">local</domain>
        <!-- Android emulator host-loopback address -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Localhost loopback addresses for debug tooling -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- All other traffic (internet): enforce TLS, block cleartext HTTP -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
